.define yabai_focus : /opt/homebrew/bin/yabai -m window --focus {{1}} || /opt/homebrew/bin/yabai -m display --focus {{1}}
.define resize_window : /opt/homebrew/bin/yabai -m window --resize {{1}}:{{2}}:{{3}}
.define yabai_swap : /opt/homebrew/bin/yabai -m window --swap {{1}} || (/opt/homebrew/bin/yabai -m window --display {{1}} && /opt/homebrew/bin/yabai -m display --focus {{1}})
.define toggle_app : open -a "{{1}}" || osascript -e 'tell app "{{1}}" to quit'
.define focus_space : /opt/homebrew/bin/yabai -m space --focus {{1}}
.define window_to_space : /opt/homebrew/bin/yabai -m window --space {{1}}


alt - j : @yabai_focus("south")
alt - k : @yabai_focus("north")
alt - h : @yabai_focus("west")
alt - l : @yabai_focus("east")

shift + alt - j : @yabai_swap("south")
shift + alt - k : @yabai_swap("north")
shift + alt - h : @yabai_swap("west")
shift + alt - l : @yabai_swap("east")

cmd + alt - h : @resize_window("left", "-20", "0")
cmd + alt - l : @resize_window("right", "20", "0")

alt - 1 : @focus_space("1")
alt - 2 : @focus_space("2")
alt - 3 : @focus_space("3")
alt - 4 : @focus_space("4")
alt - 5 : @focus_space("5")

shift + alt - 1 : @window_to_space("1")
shift + alt - 2 : @window_to_space("2")
shift + alt - 3 : @window_to_space("3")
shift + alt - 4 : @window_to_space("4")
shift + alt - 5 : @window_to_space("5")

shift + alt - t : /opt/homebrew/bin/yabai -m space --create
shift + alt - w : /opt/homebrew/bin/yabai -m space --destroy

shift + alt - y : /opt/homebrew/bin/yabai -m space --mirror y-axis 
shift + alt - x : /opt/homebrew/bin/yabai -m space --mirror x-axis 
shift + alt - r : /opt/homebrew/bin/yabai -m space --rotate 270 

shift + alt - f : /opt/homebrew/bin/yabai -m window --toggle float

ctrl - return : /opt/homebrew/bin/yabai -m window --toggle zoom-fullscreen
cmd + shift - return : /opt/homebrew/bin/yabai -m window --toggle native-fullscreen
